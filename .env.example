# .env.local — ghi đè cấu hình cá nhân (KHÔNG commit file này)
#
# Cấu hình dùng chung đã có trong .env.shared (được track bởi repo private).
# Chỉ tạo file này nếu bạn muốn dùng key riêng hoặc ghi đè một biến cụ thể.
#
# Ví dụ:
# GROQ_API_KEY=<key_của_bạn>
# GEMINI_API_KEY=<key_của_bạn>
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/churn_db
